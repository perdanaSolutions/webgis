# ===================================================================================
# Scale env — DI LUAR git: salin ke /etc/webgis/scale.env (chmod 600, owner root).
# Dipakai: docker compose -p webgis-scale -f infra/docker-compose.scale.yaml --env-file /etc/webgis/scale.env ...
#           dan infra/scripts/deploy-main-scale.sh (membaca key di bawah lewat _env_get).
#
# JANGAN commit nilai rahasia. Default di compose/skrip = nilai PROD saat ini, jadi VPS
# utama bisa jalan tanpa menambah key baru. Server TPA mengisi override di scale.env.
#
# Kolom acuan (bukan sintaks file):
#   VAR                         | PROD (default)                                      | TPA (contoh)
#   ----------------------------|-----------------------------------------------------|------------------------------------------
#   HAPROXY_HTTP_BIND           | 127.0.0.1                                           | 0.0.0.0
#   HAPROXY_STATS_BIND          | 127.0.0.1                                           | 127.0.0.1
#   HAPROXY_MTLS_BIND           | 0.0.0.0                                             | 127.0.0.1 (atau biarkan, firewall tutup)
#   HAPROXY_API_HOST            | api-webgis-prod.perdanasolusiteknologi.com          | 10.10.2.206
#   HAPROXY_FE_HOST             | webgis-prod.perdanasolusiteknologi.com              | 10.10.2.206
#   BACKEND_DB_HOST             | pgbouncer.internal                                  | pgbouncer.internal
#   PGB_DB_HOST                 | gis-postgres                                        | global-postgres
#   PGB_DB_NAME / DB_NAME       | gis_db_v4                                           | db_gis
#   PG_CONTAINER (deploy)       | gis-postgres                                        | global-postgres
#   BACKUP_DIR (deploy)         | /var/backups/postgres                               | /var/backups/postgres (atau path TPA)
#   DEPLOY_LOG                  | /var/log/webgis-deploy-main.log                     | /var/log/webgis-deploy-tpa.log
#   LB_BASE                     | http://127.0.0.1:8080                               | http://127.0.0.1:8080
#   DEPLOY_BRANCH               | main                                                | tpa_server
#   DEPLOY_NOTIFY               | /usr/local/sbin/webgis-deploy-notify                | (kosongkan jika tidak ada Telegram)
#   GLOBAL_NETWORK_NAME         | global-network                                      | global-network
#   MTLS_ENABLED                | true                                                | false (opsional)
#   CORS_ORIGINS                | https://webgis-prod.perdanasolusiteknologi.com      | http://10.10.2.206:8080
#   NUXT_PUBLIC_* (dashboard)   | https://api-webgis-prod.../api                      | http://10.10.2.206:8080/api
# ===================================================================================

# === Wajib (rahasia) ===
REDIS_PASSWORD=<acak-32+-char>
PGB_DB_USER=<sama-dengan-DB_USER-backend>
PGB_DB_PASSWORD=<sama-dengan-DB_PASSWORD-backend>

# === Postgres upstream (PgBouncer → container di GLOBAL_NETWORK_NAME) ===
PGB_DB_HOST=gis-postgres
PGB_DB_PORT=5432
PGB_DB_NAME=gis_db_v4
PGB_DEFAULT_POOL_SIZE=20
# Nama jaringan Docker eksternal tempat postgres berada (default global-network).
# GLOBAL_NETWORK_NAME=global-network

# === Hostname di dalam stack yang dipakai backend/worker untuk PgBouncer ===
# Prod & TPA saat ini memakai alias pgbouncer.internal (hindari bentrok nama di global-network).
# BACKEND_DB_HOST=pgbouncer.internal

# === Replicas (opsional) ===
BACKEND_REPLICAS=2
DASHBOARD_REPLICAS=1

# === HAProxy bind & Host ACL (default = prod di belakang Caddy) ===
HAPROXY_HTTP_BIND=127.0.0.1
# HAPROXY_STATS_BIND=127.0.0.1
# HAPROXY_MTLS_BIND=0.0.0.0
HAPROXY_API_HOST=api-webgis-prod.perdanasolusiteknologi.com
HAPROXY_FE_HOST=webgis-prod.perdanasolusiteknologi.com

# === mTLS di proses backend (compose menimpa; false = tidak listen :8443) ===
# MTLS_ENABLED=true

# === Deploy script (infra/scripts/deploy-main-scale.sh) ===
# PG_CONTAINER=gis-postgres
# BACKUP_DIR=/var/backups/postgres
# KEEP_DUMPS=10
# DEPLOY_LOG=/var/log/webgis-deploy-main.log
# LB_BASE=http://127.0.0.1:8080
# HAPROXY_STATS_URL=http://127.0.0.1:8404/stats;csv
# DEPLOY_BRANCH=main
# DEPLOY_NOTIFY=/usr/local/sbin/webgis-deploy-notify
# COMPOSE_PROJECT=webgis-scale
# SKIP_DB_STEPS=0

# === Checklist yang biasanya ada di backend_fastapi/.env & gis-dashboard/.env
#     (BUKAN di scale.env; beda per server, jangan di-commit) ===
# backend_fastapi/.env:
#   DB_NAME, DB_USER, DB_PASSWORD, CORS_ORIGINS, SECRET_KEY, FOTO_UDARA_WMS_TOKEN, SERVER_LOCAL, ...
# gis-dashboard/.env:
#   NUXT_PUBLIC_API_BASE_URL_PYTHON, NUXT_API_BASE_URL_PYTHON_SERVER (ditima compose ke http://haproxy/api),
#   NUXT_API_PROXY_TARGET, TOKEN_BASE_MAP, NUXT_PUBLIC_AUTH_COOKIE_SECURE
