# REFERENSI SAJA — LB utama WEBGIS adalah HAProxy (lihat ../haproxy/haproxy.cfg).
# File ini tidak dipakai docker-compose.scale.yaml.
# Sticky session: OFF. Jangan aktifkan ip_hash.

upstream gis_api {
    least_conn;
    server 10.0.1.11:8000 max_fails=3 fail_timeout=10s;
    server 10.0.1.12:8000 max_fails=3 fail_timeout=10s;
    keepalive 32;
}

upstream gis_fe {
    least_conn;
    server 10.0.1.21:3000 max_fails=3 fail_timeout=10s;
    server 10.0.1.22:3000 max_fails=3 fail_timeout=10s;
}

server {
    listen 443 ssl http2;
    server_name gis.example.invalid;  # [PERLU KONFIRMASI]

    location /health {
        proxy_pass http://gis_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    location /api/ {
        proxy_pass http://gis_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 100m;
        proxy_read_timeout 300s;
    }

    location / {
        proxy_pass http://gis_fe;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
