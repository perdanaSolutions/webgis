# App
PROJECT_NAME=GIS Plantation API
API_V1_STR=/api/v1

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change_me
DB_NAME=gis_db

# Auth/JWT
SECRET_KEY=change_me_to_strong_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Seed Admin
SEED_ADMIN_USERNAME=superadmin
SEED_ADMIN_EMAIL=superadmin@plantation.com
