# App
PROJECT_NAME=GIS Plantation API
API_V1_STR=/api/v1

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change_me
DB_NAME=gis_db

# Auth/JWT
SECRET_KEY=change_me_to_strong_random_secret
ALGORITHM=HS256
# 1 hari, sama dengan cookie sesi frontend (SESSION_MAX_AGE_SECONDS)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Seed Admin
SEED_ADMIN_USERNAME=superadmin
SEED_ADMIN_EMAIL=superadmin@plantation.com
SEED_ADMIN_PASSWORD=

# Redis (cache API baca halaman peta / blok profile).
# Kosongkan REDIS_URL atau set REDIS_MAP_ENABLED=false untuk mematikan cache.
# Contoh dengan password: redis://:password@127.0.0.1:6379/0
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_MAP_ENABLED=true
REDIS_MAP_TTL_SECONDS=900
REDIS_MAP_MAX_BYTES=67108864

# mTLS backend-external. HTTP dashboard tetap di HTTP_PORT.
# Sertifikat dibuat dengan: bash scripts/generate_mtls_certs.sh
# ca.key ada di certs/private/ dan tidak boleh dipasang di aplikasi.
HTTP_HOST=127.0.0.1
HTTP_PORT=8000
MTLS_ENABLED=true
MTLS_HOST=0.0.0.0
MTLS_PORT=8443
MTLS_CERTFILE=certs/runtime/server.crt
MTLS_KEYFILE=certs/runtime/server.key
MTLS_CA_FILE=certs/runtime/ca.crt
MTLS_ALLOWED_CNS=backend-external
MTLS_REQUIRED_PATHS=/api/
